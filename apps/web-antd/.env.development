# 端口号
VITE_PORT=5666

VITE_BASE=/guoba-plugin-mock-root/

# 接口地址
VITE_GLOB_API_URL=/guoba-plugin-mock-root/api

# vue-router 模式
VITE_ROUTER_HISTORY=hash

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
